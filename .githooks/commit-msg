#!/bin/sh
# Checks commit messages against Conventional Commits
# (https://www.conventionalcommits.org):
#
#   type(optional-scope): short summary
#
#   optional body, separated by a blank line
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
MAX=72

# First line that is not a comment.
subject=$(grep -v '^#' "$1" | head -n 1)
second=$(grep -v '^#' "$1" | sed -n 2p)

# Messages git writes itself are left alone.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  got:      $subject" >&2
  echo "  expected: type(scope): summary   e.g. feat(photos): add carousel" >&2
  echo "  types:    $(echo "$TYPES" | sed 's/|/, /g')" >&2
  exit 1
}

echo "$subject" | grep -Eq "^($TYPES)(\([a-z0-9._/-]+\))?!?: [^ ].*$" ||
  fail "subject must start with a type, then ': ' and a summary"

[ "${#subject}" -le "$MAX" ] ||
  fail "subject is ${#subject} characters; keep it to $MAX or fewer"

case "$subject" in
  *.) fail "subject must not end with a full stop" ;;
esac

summary=${subject#*: }
case "$summary" in
  [A-Z]*) fail "summary starts with a lower-case letter" ;;
esac

[ -z "$second" ] ||
  fail "leave a blank line between the subject and the body"

exit 0
